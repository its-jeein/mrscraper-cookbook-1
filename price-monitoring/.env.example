# Your MrScraper API token. Free tier at https://app.mrscraper.com
# Copy this file to .env and paste your real token. Never commit .env.
MRSCRAPER_API_TOKEN=atk_your_token_here

# --- Optional: SMS alerts via Twilio Programmable Messaging ---------------
# Leave these unset to run without SMS (the monitor still prints its summary).
# Find the SID/token in the Twilio Console; the FROM number must be a Twilio
# number (or Messaging Service sender) you own. Never commit real values.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15550000000
ALERT_TO_NUMBER=+15551111111

# Set NOTIFY_DRY_RUN=1 to print the exact SMS body without sending anything.
# NOTIFY_DRY_RUN=1
